# =============================================================================
# AGRO-POS — Environment Variables
# Copy this file to .env and fill in your values
# .env must NEVER be committed to the repository
# =============================================================================

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# Used by: FastAPI backend (asyncpg), MCP postgres server
# -----------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agro_pos

# Assembled automatically by app/core/config.py — do not set manually
# DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Used by MCP postgres server (sync driver — MCP does not use asyncpg)
# Assembled automatically in .claude/config.json
# POSTGRES_CONNECTION_STRING=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# -----------------------------------------------------------------------------
# FastAPI
# -----------------------------------------------------------------------------
API_HOST=localhost
API_PORT=8000
DEBUG=true
DB_ECHO=false

# -----------------------------------------------------------------------------
# GitHub MCP
# Create a token at: https://github.com/settings/tokens
# Required scopes: repo, read:org
# -----------------------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Filesystem MCP
# Absolute path to the project root — used by MCP filesystem server
# -----------------------------------------------------------------------------
PROJECT_ROOT=/absolute/path/to/agro-pos

SECRET_KEY=generar-con-el-comando:-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

K8S_NAMESPACE=default          # el namespace donde corre el pod
K8S_POSTGRES_SERVICE=postgres  # nombre del servicio en Kubernetes